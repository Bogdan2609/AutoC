APP_ENV=development
ADMIN_API_TOKEN=replace-with-a-long-random-private-token
BROWSER_CSRF_SECRET=replace-with-long-random-browser-csrf-secret
POSTGRES_PASSWORD=change-strong-db-password
PUBLIC_BASE_URL=http://localhost:8000
OFFER_MAX_AGE_SECONDS=900
SUPPLIER_API_ENABLED=false
SUPPLIER_PROCUREMENT_ENABLED=false
# Extra explicit global switch for manual ROSSKO GetCheckout; does NOT enable automatic purchasing.
REAL_SUPPLIER_CHECKOUT_ENABLED=false
YOOKASSA_SHOP_ID=
YOOKASSA_SECRET_KEY=
YOOKASSA_VAT_CODE=0
PARTKOM_LOGIN=
PARTKOM_PASSWORD=
ADEO_LOGIN=
ADEO_PASSWORD=
FORUM_LOGIN=
FORUM_PASSWORD=
ROSSKO_KEY1=
ROSSKO_KEY2=
ROSSKO_DELIVERY_ID=
ROSSKO_ADDRESS_ID=

# External searches: requires Redis, credentials and SUPPLIER_API_ENABLED=true
DISCOVERY_IP_PER_MINUTE=6
DISCOVERY_IP_PER_HOUR=30
DISCOVERY_GLOBAL_PER_MINUTE=90
SUPPLIER_REQUESTS_PER_HOUR=60
DISCOVERY_MAX_PENDING_JOBS=200

# Never enable on production: admin-only offline order simulation.
MARKETPLACE_DEMO_MODE=false
# Named credential profiles (examples only; do not commit actual keys):
# SUPPLIER_PROFILE_KAZAN_ROSSKO_KEY1=
# SUPPLIER_PROFILE_KAZAN_ROSSKO_KEY2=
# SUPPLIER_PROFILE_KAZAN_ROSSKO_DELIVERY_ID=
# SUPPLIER_PROFILE_KAZAN_ROSSKO_ADDRESS_ID=
